# Word temp files
~$*

# Transient HTTP cache for scripts/fetch_dem.py.
# Every batch of the elevation grid is cached so an interrupted run resumes for
# free. It records HOW the data was fetched, not the data, and it grows by one
# small file per request. Safe to delete at any time; the fetcher rebuilds it.
backend/data/dem_cache/

# HK Lands Department 6-NW-12D source glTF data (~2.2 GB).
# Proprietary data that must be obtained separately; not redistributable.
backend/6-NW-12D/

# 3D Tiles build outputs — large binary and texture files generated by
# scripts/build_3dtiles.py. tileset.json is small and committed; b3dm and
# per-building textures are not.
backend/data/rasters/3dtiles/*.b3dm
backend/data/rasters/3dtiles/*.jpg
backend/data/rasters/3dtiles/*.png
backend/data/rasters/3dtiles/*.PNG

# High-resolution terrain texture (61 MB) generated by ingest_terrain_gltf.py.
backend/data/rasters/terrain_texture_hsk.jpg

# Debug / scratch files
error.md
