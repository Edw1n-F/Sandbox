# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/
.env

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local

# vitest's scratch dir. Vitest writes into TEMP/TMP, and on this host both point
# somewhere it cannot use, so a run redirects them here:
#   TEMP=$PWD/.vitest-tmp TMP=$PWD/.vitest-tmp npx vitest run
frontend/.vitest-tmp/

# Editor
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Word temp files
~$*

# Transient HTTP cache for scripts/fetch_dem.py.
# Every batch of the elevation grid is cached so an interrupted run resumes for
# free. It records HOW the data was fetched, not the data, and it grows by one
# small file per request. Safe to delete at any time; the fetcher rebuilds it.
backend/data/dem_cache/

# Transient HTTP cache for scripts/fetch_heat_anchor.py. Same contract: one file
# per HKO request so an interrupted fetch resumes for free. The anchor itself is
# committed under backend/data/reference/heat_anchor.json -- this is only the
# fetch cache, and it is safe to delete at any time.
backend/data/heat_cache/

# Live run output: what POST /scenes/{id}/run writes. One wet grid, one heatmap
# and their sidecars, overwritten on every run -- the render of one scenario,
# not an artefact anyone should diff. The committed wetgrid_hsk.png /
# heatmap_hsk.png are the offline pipeline's canonical outputs and are NOT under
# this directory, which is exactly why run output lives in its own.
backend/data/rasters/run/

# The JSON file store is a RUNTIME store, not source. The seeded fixtures that
# the app and the tests boot from ARE committed:
#   backend/data/scenes/51e03c37-...json            the seeded scene
#   backend/data/plans/77593516-...json             the baseline plan
# (The derived-interventions plan and its features were purged on 14 Oct 2026:
# they were authored against the old 786 ha extent and fell outside the grid.)
# Everything else under those three directories is residue from running the
# suites or poking the API by hand. The suites that create records now redirect
# settings.*_dir at a temp copy (backend/tests/_tmpstore.py), so running them no
# longer adds to it -- but poking the API by hand still does, and without this
# the residue would be committed. See docs/FILE_STRUCTURE.md.
backend/data/scenes/*
backend/data/plans/*
backend/data/interventions/*
!backend/data/scenes/51e03c37-5360-43b0-a094-fbaca38cd70b.json
!backend/data/plans/77593516-77ab-4e93-9451-cf1b5b4cbf93.json
# Planned projects ARE committed (backend/data/projects/<id>.json is the source,
# scripts/seed_projects.py writes the plan), so that every clone and every tester
# sees the same projects instead of an empty Projects panel. The seeder names them
# `project-<id>` precisely so one glob covers every future project: a random uuid
# could not be allowlisted here, and would differ on every machine.
!backend/data/plans/project-*.json
!backend/data/interventions/project-*.json

# Agent memory, not project source
.workbuddy/

# Session screenshots and transient scratch from agent tools.
.tmp/

# Written by frontend/scripts/verify-3d.mjs on every run; not source.
frontend/verify-before-run.png
frontend/verify-after-run.png

# Original source directory for the MTR station model (duplicate of backend/model/).
backend/plan_project-model/

# Local raw-tile dump used while rebuilding the Open3Dhk + Overture pipeline.
# ~1.9 GB on this host. The committed artefacts (buildings_hsk.json, DSM/DEM
# npz files) are what the pipeline produces from it, not the source itself.
raw_data/

# Local dev-server logs (uvicorn / vite stdout+stderr redirects). Runtime noise,
# never source; see the root uvicorn.*.log / vite.*.log left by `npm run dev`.
*.log

# Scratch files from working in the tree: latency-measurement payloads, ad-hoc
# probe JSON. Runtime noise, never source -- one was staged by accident on
# 17 Oct and had to be removed in a follow-up commit.
.tmp_*
*.tmp_*
