# Backend configuration.  Copy to `.env` before first run:
#
#   cp backend/.env.example backend/.env
#
# Every value below has a working default in app/config.py, so the app boots
# without this file.  You need it for exactly one setting: STATIC_BASE_URL.

# "file" today | "postgis" (documented target, not provisionable on this host).
# Store mode is configuration, not architecture: switching to PostGIS is a
# replacement of app/db.py + app/services/scene_service.py only. No route,
# schema or frontend change. See docs/ARCHITECTURE.md.
STORE_MODE=file

# Root of the file store: scenes/, plans/, interventions/, rasters/.
# A relative path is resolved against backend/, never against the working
# directory, so launching uvicorn from the repo root still finds the data.
DATA_DIR=./data

# Prefix for resolving terrain_url / imagery_url / overlay URLs. MUST match the
# StaticFiles mount in app/main.py, or those URLs will not resolve.
#
# This is the one setting with no safe default: left empty the API hands the
# frontend "/rasters/wetgrid_hsk.png" for a file actually served at
# "/static/rasters/wetgrid_hsk.png" -- a 404 on the last hop of the chain, which
# presents as "the toggle does nothing". Set it to /static.
STATIC_BASE_URL=/static

# --- Generative AI -------------------------------------------------------
# Leave ANTHROPIC_API_KEY empty and the AI endpoint uses a deterministic
# parser that needs no credentials, so the demo cannot die for want of a key.
# Set it to switch the GenAI path on. Never commit a real key: this file is
# the template, and .env is gitignored.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Any OpenAI-compatible endpoint. This is how a LIVE run happens with no vendor
# key at all: Ollama serves an OpenAI-compatible API at /v1, so
#   ollama pull <a tool-capable model>
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=<model>
# is a complete live configuration. OpenRouter, DeepSeek, Moonshot, DashScope,
# Groq and vLLM all speak the same shape. Check with:
#   python scripts/llm_probe.py
LLM_BASE_URL=
LLM_API_KEY=
# Prefer a NON-REASONING model. Reasoning models (e.g. nemotron-3-ultra,
# inkling) spend part of the token budget on a hidden thinking trace, so a
# small max_tokens can leave the answer empty and the call still takes 40-55 s.
# A plain chat model answers faster and needs no reasoning-channel workaround.
LLM_MODEL=
# Ollama ignores the key but the header must be present.
LLM_ALLOW_NO_KEY=true
# How to ask an OpenAI-compatible endpoint for JSON:
#   auto -- send response_format, drop it if the server 400s (default; most
#           free OpenRouter models reject the parameter)
#   json -- always send it
#   off  -- never send it; rely on the JSON contract appended to the prompt
LLM_JSON_MODE=auto
# Model ids tried after LLM_MODEL, in order, when it answers 429/5xx or returns
# empty content. Free tiers are shared pools: on OpenRouter a ":free" model being
# throttled upstream is routine, and reasoning models often send every token to
# the reasoning channel (a 200 with nothing in it). Use non-reasoning fallbacks
# for the same reason as LLM_MODEL.
#
# NOTE (measured 2026-10-13): on OpenRouter's current free tier, nearly every
# model IS a reasoning model. nemotron-3.5-lightning, nemotron-3-super, liquid
# lfm-2.5, cohere north-mini and apodex all return empty content at a small
# max_tokens because they spend the whole budget on the hidden trace. The only
# reliably non-reasoning free family is Google's Gemma. Example that works:
#   LLM_MODEL=google/gemma-4-31b-it:free
#   LLM_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free
LLM_FALLBACK_MODELS=
