# Frontend runtime configuration.  Copy to `.env.local`:
#
#   cp frontend/.env.local.example frontend/.env.local
#
# `.env.local` is gitignored. Never commit a token here.

# Deliberately EMPTY. Cesium's default Viewer pulls Bing imagery through Cesium
# Ion and renders a broken globe without a token. This app sets
# `baseLayer: false` and supplies OpenStreetMapImageryProvider explicitly, so it
# runs with zero credentials. Leave this blank unless you know you need it.
VITE_CESIUM_ION_TOKEN=

# Leave empty: the Vite dev server proxies /api and /static to
# http://localhost:8000 (see vite.config.ts), so the API is same-origin and
# needs no configuration. Set it only if you serve the API from elsewhere.
VITE_API_BASE_URL=

# Which scene to load on boot.  Printed by `python scripts/seed_scene.py`.
VITE_SCENE_ID=
