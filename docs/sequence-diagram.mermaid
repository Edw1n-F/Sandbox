%% Phase 2 call flows — generate, card, revalidate, apply
%% Author: 高见远 (Gao), Architect · 18 Oct 2026 · HEAD cd7a87a
%% See docs/PHASE2_DESIGN.md. Frozen signatures: validate_proposal /
%% validate_batch unchanged; REASON_CODES stays at nine members.

sequenceDiagram
    autonumber
    participant U as Planner
    participant R as routers/scenes.py
    participant AP as ai_plan
    participant PC as proposal_constraints
    participant SM as sandbox_model
    participant PCB as parameter_card
    participant S as scene_service

    rect rgb(238, 247, 255)
    note over U,R: FLOW 1 — generate with answers carried forward (T01 + T03)
    U->>R: POST /ai-plan {instruction, apply:false, answeredQuestions[]}
    R->>AP: generate_proposals(scene_id, instruction, answered=…)
    AP->>AP: provider.propose(...) or HeuristicProvider rescue
    AP->>SM: load_grounding()  %% T05: mask = building_mask (union), not bbox
    AP->>PC: building_mask(overlay)
    AP->>PC: validate_batch(grids, features, occupied, claimed)
    loop each candidate, in provider order
        PC->>PC: validate_proposal → freeze geometry, size, constraints
        PC->>PC: parameters_for_kind(kind, override)
        Note over PC: override = the server's parse of an<br/>answered usableStorageDepth, if in range.<br/>Unedited → ASSUMPTION / class default.<br/>Edited → USER_ASSUMPTION + defaultValue (R17)
        PC->>PC: questions_for_kind(kind, params, batch)
        Note over PC: id == parameter name (R10). Pure function.<br/>The model never supplies a question (R9)
        PC->>SM: depth_is_acceptable(depth)  %% R16, one predicate
    end
    PC-->>AP: (accepted, rejected)
    AP->>AP: batch-scope questions (drainage/overflow, treeCover)
    AP-->>R: features, rejected, provider, groundingNotes, candidateCounts
    R-->>U: 200 AIPlanResponse {proposals, rejected, questions}
    Note over R: T01 FIX: "rejected" passed at ALL THREE<br/>model_validate sites (292, 305, 325).<br/>Today the field is always [] (F5)
    end

    rect rgb(240, 255, 240)
    note over U,R: FLOW 2 — the parameter card (T02)
    U->>R: GET /scenes/{id}/parameter-card?planId&rainfallMm&temperatureC&tideState
    R->>SM: load_grids()
    R->>SM: ledger_for_scenario(grids, features, rainfall_mm)
    SM->>SM: storage_ledger → _area_stats (now with classAreaM2)
    SM-->>R: {baseline{…classAreaM2…}, scenario{…}, delta{storageCapacityM3,…}}
    R->>PCB: build(grids, ledger, tide, temperature_c, rainfall_mm, features)
    PCB->>PCB: siteAreaHa, per-class areas, green, imperviousShare, bare
    PCB->>PCB: explicitStorageAddedM3 = cells × cell_area × depth  (GROSS)
    PCB->>PCB: netStorageCapacityChangeM3 = ledger.delta.storageCapacityM3 (NET)
    Note over PCB: both printed, never conflated.<br/>gross ≥ net asserted (R4)
    PCB->>PCB: soilGroup → value None, "no soil survey exists"  (R6)
    PCB->>PCB: heat row → raw temperatureC, presets are UNWIRED  (R5)
    PCB->>PCB: every date → null, or parsed from CANONICAL_SCENE_ID. Never today (R7)
    PCB-->>R: ParameterCard{status, warning, entries[]}
    R-->>U: 200 {sceneId, planId, status, warning, sources, inputs, entries}
    end

    rect rgb(255, 250, 235)
    note over U,R: FLOW 3 — the planner edits an assumption (T04)
    U->>U: edit storageDepthM 1.50 → 0.80 in the confirm gate
    U->>R: POST /ai-plan/revalidate {proposals[]}
    R->>PC: validate_batch(grids, edited proposals, occupied, claimed)
    PC->>PC: geometry, size, constraints recomputed — IDENTICAL (R15)
    PC->>PC: parameters_for_kind(kind, override=0.80) → USER_ASSUMPTION
    PC->>PC: _accepted_warning: replaces "Depth is a class assumption"
    Note over PC: geometryAffectingParameters: []<br/>valuesAffectingOnly: ["parameters.storageDepthM"]
    PC-->>R: proposals (edited labels) + rejected
    R-->>U: 200 AIPlanResponse
    alt depth outside MIN..MAX
        R-->>U: 422 {detail names parameter, value, 0.05–10 m range}
        Note over R: a 422, NOT a new reasonCode (R20).<br/>REASON_CODES stays at nine.
    end
    end

    rect rgb(255, 240, 245)
    note over U,R: FLOW 4 — apply, now validated (T04, closes the M6 hole)
    U->>R: POST /ai-plan/apply {instruction, proposals[]}
    R->>AP: apply_proposals(scene_id, instruction, features, …)
    AP->>PC: validate_batch(grids, features, occupied, claimed)  %% NEW
    Note over AP: before this, apply_proposals persisted<br/>whatever it was given — so a client could<br/>already set any storageDepthM (M6)
    alt every feature accepted
        AP->>S: create_plan(scene_id, PlanCreate)
        S-->>AP: planId, intervention_count
        AP-->>R: {planId, features, provider, types, groundingNotes}
        R-->>U: 200 AIPlanResponse
    else any feature refused
        AP-->>R: rejected[] (frozen reasonCode + warning)
        R-->>U: 200 AIPlanResponse {features:0, rejected}
        Note over R: the refusal is CARRIED, never dropped (R21)
    end
    end

    rect rgb(248, 240, 255)
    note over U,S: FLOW 5 — the run reads the hand-set depth
    U->>R: POST /scenes/{id}/run {planIds[], rainfallMm, temperatureC, tideState}
    R->>SM: run_scenario → apply_interventions(grids, features)
    SM->>SM: depth = params["storageDepthM"]  %% the hand-set 0.80
    SM->>SM: depth_is_acceptable(depth) — refuse with a stated why if not
    SM->>SM: storage_over[(r,c)] = depth  → _runoff_and_unstored
    SM->>SM: _area_stats → stats.delta.storageCapacityM3
    SM-->>U: stats {inputs, baseline, scenario, delta, status, warning}
    Note over SM: the card's NET figure and this run's<br/>delta.storageCapacityM3 are the same number,<br/>computed once (R1)
    end