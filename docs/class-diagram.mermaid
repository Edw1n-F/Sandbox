%% Phase 2 — parameter card, questions[], editable assumptions
%% Author: 高见远 (Gao), Architect · 18 Oct 2026 · HEAD cd7a87a
%% Every field below is additive and defaulted; see docs/PHASE2_DESIGN.md §7.

classDiagram
    direction LR

    class ParameterCard {
        +str sceneId
        +str? planId
        +str status = SCREENING_PARAMETER_CARD
        +str warning
        +dict sources
        +dict inputs
        +list~ParameterCardEntry~ entries
    }

    class ParameterCardEntry {
        +str key
        +str label
        +float? value = None
        +str unit
        +str status
        +str source
        +str? date = None
        +str confidence
        +str note
        note: value=None means "this project has no
        such number" -- never an omission
    }

    class Confidence {
        <<enumeration>>
        MEASURED
        DERIVED
        ASSUMED
        UNAVAILABLE
    }

    class parameter_card {
        <<module>>
        +build(grids, ledger, tide, temperature_c, rainfall_mm, features) ParameterCard
        -class_area_entry(key, base, scen) ParameterCardEntry
        -soil_group_entry() ParameterCardEntry
        -heat_entry(temperature_c, lst_meta) ParameterCardEntry
        -storage_entries(cells, cell_area, depth, net) list
        note: owns NO numeric literals except 0.0/1.0
        unit conversions; every value is read from a
        dict this request computed (R1)
    }

    class sandbox_model {
        <<module>>
        +storage_ledger(grids, land_class, rainfall_mm, storage_over) dict
        +_area_stats(grids, land_class, storage_over) dict
        +ledger_for_scenario(grids, features, rainfall_mm) dict
        +apply_interventions(grids, features) tuple
        +depth_is_acceptable(depth) bool
        +MIN_STORAGE_DEPTH_M = 0.05
        +MAX_STORAGE_DEPTH_M = 10.0
        +DEFAULT_RAINFALL_MM = 450.0
        +MAX_INTERVENTION_COVERAGE = 0.25
        +MIN_SITE_CELLS = 40
    }

    class _area_stats {
        +float storageCapacityM3
        +float imperviousShare
        +float greenWaterAreaM2
        +dict classAreaM2 NEW
        note: classAreaM2 is the ONE per-class area
        sum; greenAreaM2 / pavedAreaM2 are re-read
        from it so one computation has two published
        names (R2)
    }

    class ProposalQuestion {
        +str id
        +str parameter
        +str scope = PROPOSAL | SITE
        +str prompt
        +str whyItMatters
        +str status = OPEN | ANSWERED | NOT_APPLICABLE
        +str? answer = None
        +float? answeredValue = None
        +str assumption
        +str source
        +str confidence
        +str warning
        note: id IS the parameter name (R10) --
        stable, order-free, matchable by ==
    }

    class AnsweredQuestion {
        +str id
        +str parameter
        +str? answer = None
        note: the client carries answers forward;
        there is no server-held proposal state
    }

    class ParameterEntry {
        +float value
        +str unit
        +str status = ASSUMPTION | USER_ASSUMPTION
        +str source
        +str? date = None
        +str confidence
        +float? defaultValue = None
        +bool edited = False
    }

    class InterventionProposal {
        +str? site_id
        +str? rationale
        +str? basis
        +ProposalSize size
        +ProposalRequested requested
        +ProposalConstraints constraints
        +dict parameters
        +list~ProposalQuestion~ questions = []
        +str status
        +str warning
        +dict params
    }

    class AIPlanResponse {
        +str? plan_id
        +int features
        +str provider
        +list~InterventionProposal~ proposals
        +list~ProposalRejection~ rejected
        +list~ProposalQuestion~ questions = []
        +str status
        +str warning
    }

    class AIPlanRequest {
        +str instruction
        +str provider
        +int max_features
        +bool apply
        +list answeredQuestions = []
    }

    class proposal_constraints {
        <<module>>
        +validate_proposal(grids, candidate, occupied, claimed) dict
        +validate_batch(grids, candidates, occupied, claimed) tuple
        +parameters_for_kind(kind, override) dict
        +questions_for_kind(kind, params, batch) list
        +building_mask(ov) ndarray
        +REASON_CODES frozenset (9 members, FROZEN)
    }

    class ai_plan {
        <<module>>
        +generate_proposals(scene_id, instruction, prefer, max_features, allowed_types, answered) dict
        +apply_proposals(scene_id, instruction, features, provider, notes, counts) dict
        +load_grounding() Grounding
        +_split_under_cap(cells, cap, min_cells, rows, cols) list
        +MAX_SITES_PER_POOL = 3
    }

    ParameterCard "1" o-- "11" ParameterCardEntry : entries
    ParameterCardEntry ..> Confidence : confidence
    parameter_card ..> ParameterCard : builds
    parameter_card ..> sandbox_model : reads ledgers from
    sandbox_model *-- _area_stats : owns

    AIPlanResponse "1" o-- "n" InterventionProposal : proposals
    AIPlanResponse "1" o-- "n" ProposalQuestion : questions (SITE scope)
    InterventionProposal "1" o-- "n" ProposalQuestion : questions (PROPOSAL scope)
    InterventionProposal "1" *-- "n" ParameterEntry : parameters
    AIPlanRequest "1" o-- "n" AnsweredQuestion : answeredQuestions
    AnsweredQuestion ..> ProposalQuestion : matched by id

    proposal_constraints ..> InterventionProposal : _proposal_from
    proposal_constraints ..> ParameterEntry : parameters_for_kind
    proposal_constraints ..> ProposalQuestion : questions_for_kind
    ai_plan ..> proposal_constraints : validate_batch on generate AND on apply
    ai_plan ..> ParameterEntry : override from an answer
    sandbox_model ..> ParameterEntry : depth_is_acceptable